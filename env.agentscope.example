# AgentScope 配置示例

# ============ 模型配置 ============
# OpenAI 配置
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# 阿里云 DashScope 配置（推荐国内用户使用）
DASHSCOPE_API_KEY=your_dashscope_key
DASHSCOPE_MODEL=qwen-max

# ============ AgentScope 工作流配置 ============
# 默认使用的模型配置
AGENT_DEFAULT_MODEL=qwen-max

# 是否启用风险控制智能体
AGENT_ENABLE_RISK_CONTROL=true

# 是否启用报告生成智能体
AGENT_ENABLE_REPORT=true

# ============ 智能体行为配置 ============
# 数据分析智能体配置
AGENT_DATA_ANALYST_TEMPERATURE=0.7
AGENT_DATA_ANALYST_MAX_TOKENS=2000

# 策略建议智能体配置
AGENT_STRATEGY_ADVISOR_TEMPERATURE=0.8
AGENT_STRATEGY_ADVISOR_MAX_TOKENS=2000

# 风险控制智能体配置
AGENT_RISK_CONTROLLER_TEMPERATURE=0.5
AGENT_RISK_CONTROLLER_MAX_TOKENS=2000

# 执行智能体配置
AGENT_EXECUTOR_TEMPERATURE=0.3
AGENT_EXECUTOR_MAX_TOKENS=1500

# 报告智能体配置
AGENT_REPORTER_TEMPERATURE=0.6
AGENT_REPORTER_MAX_TOKENS=3000
